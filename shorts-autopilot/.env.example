# --- Claude (story, scoring, scripts) ---
ANTHROPIC_API_KEY=

# --- Competitor scan (YouTube Data API v3 key, read-only) ---
YOUTUBE_API_KEY=

# --- YouTube posting (OAuth; run `python -m autopilot auth-youtube` once to get the refresh token) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- TikTok posting (Content Posting API; scopes video.publish, video.upload) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Image generation (provider "openai" in config.yaml) ---
OPENAI_API_KEY=

# --- Voice (provider "elevenlabs" in config.yaml) ---
ELEVENLABS_API_KEY=
